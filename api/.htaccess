RewriteEngine On
RewriteCond %{HTTPS} !=on
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Fichiers internes jamais servis
RewriteRule ^(src|tests|cron)/ - [F]
RewriteRule ^(schema\.sql|DEPLOY\.md|\.env.*)$ - [F]

# API
RewriteRule ^v1/ public/index.php [L]

# Site public
RewriteRule ^$ public/index.html [L]
RewriteRule ^(docs|cle|statut|dashboard|playground|admin)/?$ public/$1.html [L]
RewriteRule ^(openapi\.yaml|robots\.txt|sitemap\.xml)$ public/$1 [L]
RewriteRule ^assets/(.+)$ public/assets/$1 [L]

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "no-referrer"
  Header always set X-Frame-Options "DENY"
  Header always set Content-Security-Policy "default-src 'self'; style-src 'self' 'unsafe-inline'; connect-src 'self'; frame-ancestors 'none'; base-uri 'none'; form-action 'self'"
</IfModule>
