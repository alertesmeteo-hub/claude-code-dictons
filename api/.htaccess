RewriteEngine On
RewriteCond %{HTTPS} !=on
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
RewriteRule ^(src|tests)/ - [F]
RewriteRule ^(schema\.sql|\.env.*)$ - [F]
RewriteCond %{REQUEST_URI} !^/(docs|openapi\.yaml)
RewriteCond %{REQUEST_URI} ^/v1/
RewriteRule ^ public/index.php [L]
RewriteRule ^docs/?$ public/docs.html [L]
RewriteRule ^openapi\.yaml$ public/openapi.yaml [L]
