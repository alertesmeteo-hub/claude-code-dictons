generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Saint {
  id                     Int      @id @default(autoincrement())
  mois                   Int
  jour                   Int
  nomPrincipal           String   @map("nom_principal") @db.VarChar(100)
  presentationHistorique String?  @map("presentation_historique") @db.Text
  autresPrenoms          String?  @map("autres_prenoms") @db.VarChar(255)
  patronage              String?  @db.Text
  traditions             String?  @db.Text
  source                 String   @db.VarChar(255)
  verifie                Boolean  @default(false)
  updatedAt              DateTime @updatedAt @map("updated_at")

  pagesJour PageJour[]

  @@unique([mois, jour], name: "uniq_jour")
  @@map("saints")
}

enum TypeDicton {
  dicton
  proverbe
  dicton_meteo
  dicton_paysan
  adage
}

model Dicton {
  id        Int        @id @default(autoincrement())
  texte     String     @db.Text
  type      TypeDicton
  mois      Int?
  jour      Int?
  source    String?    @db.VarChar(255)
  actif     Boolean    @default(true)
  updatedAt DateTime   @updatedAt @map("updated_at")

  @@map("dictons")
}

model Ville {
  id           Int     @id @default(autoincrement())
  nom          String  @db.VarChar(150)
  codePostal   String? @map("code_postal") @db.VarChar(10)
  departement  String? @db.VarChar(100)
  latitude     Decimal @db.Decimal(9, 6)
  longitude    Decimal @db.Decimal(9, 6)
  slug         String  @unique @db.VarChar(160)

  @@map("villes")
}

model StationMeteo {
  id           Int      @id @default(autoincrement())
  codeStation  String   @unique @map("code_station") @db.VarChar(20)
  nomCommune   String   @map("nom_commune") @db.VarChar(150)
  departement  String   @db.VarChar(100)
  altitudeM    Int      @map("altitude_m")
  latitude     Decimal? @db.Decimal(9, 6)
  longitude    Decimal? @db.Decimal(9, 6)

  temperatures TemperatureExtremeJour[]

  @@map("stations_meteo")
}

enum TypeTemperature {
  maxi
  mini
}

model TemperatureExtremeJour {
  id           Int             @id @default(autoincrement())
  date         DateTime        @db.Date
  stationId    Int             @map("station_id")
  station      StationMeteo    @relation(fields: [stationId], references: [id])
  type         TypeTemperature
  valeurC      Decimal         @map("valeur_c") @db.Decimal(4, 1)
  heureMesure  DateTime?       @map("heure_mesure") @db.Time()
  source       String          @db.VarChar(255)
  fetchedAt    DateTime        @default(now()) @map("fetched_at")

  @@unique([stationId, date, type], name: "uniq_station_date_type")
  @@map("temperatures_extremes_jour")
}

model PageJour {
  id           Int       @id @default(autoincrement())
  date         DateTime  @unique @db.Date
  saintId      Int?      @map("saint_id")
  saint        Saint?    @relation(fields: [saintId], references: [id])
  dictonsIds   Json?     @map("dictons_ids")
  republieeLe  DateTime? @map("republiee_le")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  @@map("pages_jour")
}

enum StatutSync {
  ok
  erreur
  partiel
}

model SyncLog {
  id        Int        @id @default(autoincrement())
  tache     String     @db.VarChar(100)
  statut    StatutSync
  message   String?    @db.Text
  createdAt DateTime   @default(now()) @map("created_at")

  @@map("sync_logs")
}
