# API PHP intermédiaire déployée sur l'hébergement OVH mutualisé (voir ovh-api/README.md)
# — seul point d'accès à la base MySQL bijouxdealertes, non joignable directement depuis l'extérieur.
OVH_API_URL="https://alertes-meteo.com/dicton-api"
OVH_API_TOKEN="même valeur que DICTON_API_TOKEN dans ovh-api/config.php"

# Slug secret de l'admin (non indexé, non devinable) — change cette valeur en prod
ADMIN_SLUG="gestion-x7f2k9"

# Fournisseur météo prévisions (Open-Meteo n'a pas besoin de clé)
# OPENWEATHER_API_KEY=""

# Météo-France DPObs (températures extrêmes France) — clé applicative gratuite
# à créer sur https://portail-api.meteofrance.fr/ (souscrire à l'API "DonneesPubliquesObservation")
METEOFRANCE_API_KEY=""

# Base URL publique du site (utilisée pour canonical, sitemap, OG)
NEXT_PUBLIC_SITE_URL="https://dicton-du-jour.alertes-meteo.com"
